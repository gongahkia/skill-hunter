{
  "manifest_version": 3,
  "name": "Judgeman",
  "version": "4.1.0",
  "description": "Readable ELIT judgments with structured local export.",
  "icons": {
    "16": "icons/judgeman-16.png",
    "32": "icons/judgeman-32.png",
    "48": "icons/judgeman-48.png",
    "128": "icons/judgeman-128.png"
  },
  "action": {
    "default_title": "Judgeman",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/judgeman-16.png",
      "32": "icons/judgeman-32.png",
      "48": "icons/judgeman-48.png",
      "128": "icons/judgeman-128.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.elitigation.sg/gd/*",
        "https://www.elitigation.sg/gdviewer/*"
      ],
      "js": [
        "browserApi.js",
        "logger.js",
        "citationAdapters.js",
        "citationLinker.js",
        "inlineCitations.js",
        "inlineStatutes.js",
        "fieldOverlay.js",
        "annotations.js",
        "caseToolkit.js",
        "extractor.js",
        "panelStyles.js",
        "contentApp.js",
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "annotationStore.js",
      "background.js"
    ]
  }
}
