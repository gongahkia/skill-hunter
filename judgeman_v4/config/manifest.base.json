{
  "manifest_version": 3,
  "name": "Judgeman",
  "version": "4.1.0",
  "description": "Readable ELIT judgments with structured local export.",
  "icons": {
    "16": "icons/judgeman-16.png",
    "32": "icons/judgeman-32.png",
    "48": "icons/judgeman-48.png",
    "128": "icons/judgeman-128.png"
  },
  "action": {
    "default_title": "Judgeman",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/judgeman-16.png",
      "32": "icons/judgeman-32.png",
      "48": "icons/judgeman-48.png",
      "128": "icons/judgeman-128.png"
    }
  },
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.elitigation.sg/gd/*",
        "https://www.elitigation.sg/gdviewer/*"
      ],
      "js": [
        "browserApi.js",
        "logger.js",
        "citationAdapters.js",
        "citationLinker.js",
        "annotations.js",
        "caseToolkit.js",
        "extractor.js",
        "contentApp.js",
        "contentScript.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
