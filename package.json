{
  "name": "judgeman-store-safe",
  "private": true,
  "version": "4.1.0",
  "description": "Store-safe packaging, tests, and tooling for the Judgeman browser extension.",
  "scripts": {
    "icons": "python3 scripts/generate-icons.py",
    "build": "node scripts/build-extension.mjs all",
    "build:chrome": "node scripts/build-extension.mjs chrome",
    "build:firefox": "node scripts/build-extension.mjs firefox",
    "package:firefox": "node scripts/package-firefox-submission.mjs",
    "lint:firefox": "npx --yes web-ext lint --source-dir dist/firefox",
    "build:safari": "node scripts/build-extension.mjs safari",
    "safari:project": "node scripts/generate-safari-project.mjs",
    "test": "node --test tests/*.test.js",
    "verify": "npm run build && npm test"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
